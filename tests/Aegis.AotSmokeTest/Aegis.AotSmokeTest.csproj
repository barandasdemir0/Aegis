<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT doğrulaması: kütüphaneler gerçekten AOT ile derlenip çalıştırılır. Yayımlama sırasında trim/AOT uyarısı
    (IL2xxx / IL3xxx) hata sayılır. Windows'ta C++ araç zinciri gerektiği için Docker'da (Linux) çalıştırılır:
    docs/TEST-INFRASTRUCTURE.md "Native AOT" bölümü.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aegis.Resilience.Core\Aegis.Resilience.Core.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Extensions.DependencyInjection\Aegis.Resilience.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Extensions.Http\Aegis.Resilience.Extensions.Http.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.RateLimiting\Aegis.Resilience.RateLimiting.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Extensions.Telemetry\Aegis.Resilience.Extensions.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Testing\Aegis.Resilience.Testing.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Extensions.Caching\Aegis.Resilience.Extensions.Caching.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Distributed.Abstractions\Aegis.Resilience.Distributed.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.AspNetCore\Aegis.Resilience.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Extensions.Aspire\Aegis.Resilience.Extensions.Aspire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenTelemetry SDK + bellek içi dışa aktarıcı: Aspire eklentisinin AddMeter bağlantısını gerçek bir MeterProvider ile sınar. -->
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core paylaşılan çerçevesi: Microsoft.Extensions.* (DI, yapılandırma, günlük, önbellek) buradan gelir. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
