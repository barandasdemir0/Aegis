<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Aegis için .NET Aspire ServiceDefaults entegrasyonu: tek çağrıyla tüm HttpClient'lara standart dayanıklılık işleyicisi, Aegis metrikleri OpenTelemetry'ye ve Aegis sağlık kontrolü (AddStandardResilienceHandler eşdeğeri).</Description>
    <PackageTags>$(PackageTags);aspire;servicedefaults;opentelemetry</PackageTags>
    <!-- Aspire yalnızca .NET 8+ üzerinde çalışır. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegis.Resilience.Core\Aegis.Resilience.Core.csproj" />
    <ProjectReference Include="..\Aegis.Resilience.Extensions.DependencyInjection\Aegis.Resilience.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\Aegis.Resilience.Extensions.Http\Aegis.Resilience.Extensions.Http.csproj" />
    <ProjectReference Include="..\Aegis.Resilience.Extensions.HealthChecks\Aegis.Resilience.Extensions.HealthChecks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yalnızca MeterProvider yapılandırma uzantısı; OpenTelemetry SDK'sını uygulama (ServiceDefaults) getirir. -->
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
  </ItemGroup>

</Project>
