<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet sürdürülebilir sonuç için sunucu GC yerine iş istasyonu GC'si (varsayılan) kullanır -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Aegis.Resilience.Core\Aegis.Resilience.Core.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.Distributed.Abstractions\Aegis.Resilience.Distributed.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Aegis.Resilience.AspNetCore\Aegis.Resilience.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Polly.Core" Version="8.8.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.8.0" />
    <!-- Ekosistem karşılaştırması (EcosystemBenchmarks): Polly v7 API'si, Polly.Caching.Memory, AspNetCoreRateLimit -->
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Polly.Caching.Memory" Version="3.0.2" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
  </ItemGroup>
</Project>
