<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Bu çözüm Aegis'i KAYNAK KOD olarak değil, gerçek .nupkg paketleri olarak tüketir (son kullanıcının gördüğü hâl).
    Paketleri üretmek için (repo kökünde):
      dotnet pack Aegis.slnx -c Release -o artifacts\packages -p:Version=2.0.0
  -->
  <packageSources>
    <clear />
    <add key="aegis-local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="aegis-local">
      <package pattern="Aegis.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
